{
  "name": "fumble-and-glory",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && tsc --noEmit && vite build",
    "preview": "vite preview",
    "validate": "node scripts/validate.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --reporter=default --reporter=json --outputFile.json=test-results/vitest.json",
    "test:e2e": "playwright test",
    "lighthouse": "npx --yes @lhci/cli@0.15.1 autorun",
    "badges": "node scripts/badges.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.10.2",
    "@vitest/coverage-v8": "5.0.5",
    "ajv": "8.17.1",
    "jsdom": "25.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
