{
  "name": "fumble-and-glory",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && tsc --noEmit && vite build",
    "preview": "vite preview",
    "validate": "node scripts/validate.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --reporter=default --reporter=json --outputFile.json=reports/vitest.json",
    "test:e2e": "playwright test",
    "test:e2e:browser": "playwright install --with-deps chromium",
    "lighthouse": "lhci autorun",
    "badges": "node scripts/badges.mjs"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@vitest/coverage-v8": "4.1.11",
    "ajv": "8.20.0",
    "jsdom": "25.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "4.1.11"
  },
  "overrides": {
    "tmp": "0.2.7",
    "uuid": "11.1.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
